{
  "name": "fpdf-vercel",
  "version": "1.0.0",
  "description": "Application web pour créer et lire des PDF avec Node.js et PDF-Lib",
  "main": "api/index.js",
  "scripts": {
    "start": "node api/index.js",
    "dev": "nodemon api/index.js",
    "vercel-build": "npm install",
    "vercel-start": "node api/index.js"
  },
  "dependencies": {
    "express": "^4.18.2",
    "pdf-lib": "^1.17.1",
    "cors": "^2.8.5",
    "multer": "^1.4.5-lts.1",
    "path": "^0.12.7"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "vercel": {
    "version": 2,
    "builds": [
      {
        "src": "api/index.js",
        "use": "@vercel/node"
      }
    ],
    "routes": [
      {
        "src": "/api/(.*)",
        "dest": "api/index.js"
      },
      {
        "src": "/(.*)",
        "dest": "public/index.html"
      }
    ]
  }
}
